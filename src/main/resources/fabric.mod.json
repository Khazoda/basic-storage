{
  "schemaVersion": 1,
  "id": "basicstorage",
  "version": "${version}",
  "name": "Basic Storage",
  "description": "Vanilla-friendly mass item storage",
  "authors": [
    "Khazoda"
  ],
  "contact": {
    "homepage": "https://khazoda.com#basicstorage",
    "sources": "https://github.com/Khazoda/basic-storage",
    "issues": "https://github.com/Khazoda/basic-storage/issues"
  },
  "license": "MIT",
  "icon": "assets/basicstorage/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.khazoda.basicstorage.BasicStorage"
    ],
    "client": [
      "com.khazoda.basicstorage.BasicStorageClient"
    ],
    "fabric-datagen": [
      "com.khazoda.basicstorage.datagen.BasicStorageDataGenerator"
    ],
    "sodium:config_api_user": [
      "com.khazoda.basicstorage.integration.sodium.BasicStorageSodiumIntegration"
    ]
  },
  "mixins": [
    "basicstorage.mixins.json",
    {
      "config": "basicstorage.client.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.com/invite/vEZUkSxwR9"
      }
    }
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
